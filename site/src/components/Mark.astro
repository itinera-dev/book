---
// The logo's mark, inline, in the colour of the text around it. It is always
// next to the name "Itinera", which says what it is, so a screen reader skips it.

import { MARK_BOX, markShapes } from '../lib/logo.mjs';

interface Props {
	class?: string;
}

const { class: className } = Astro.props;
---

<svg
	class={className}
	xmlns="http://www.w3.org/2000/svg"
	viewBox={`0 0 ${MARK_BOX.width} ${MARK_BOX.height}`}
	aria-hidden="true"
	focusable="false"
	set:html={markShapes('currentColor')}
/>
